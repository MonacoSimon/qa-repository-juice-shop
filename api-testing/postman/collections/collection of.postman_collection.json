              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "const token = response.authentication.token;",
                  "",
                  "pm.environment.set(\"authToken\", token);",
                  "console.log(\"Token guardado:\", token);",
                  "",
                  "pm.test(\"Login exitoso\", function () {",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response).to.have.property(\"authentication\");",
                  "    pm.expect(response.authentication).to.have.property(\"token\");",
                  "    pm.expect(response.authentication.token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Verificar datos del usuario\", function () {",
                  "    const response = pm.response.json();",
                  "    ",
                  "    pm.expect(response.authentication.umail).to.equal(pm.environment.get(\"nuevoEmail\"));",
                  "    pm.expect(response.authentication.bid).to.be.a(\"number\");",
                  "    pm.expect(response.authentication.bid).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"Tiempo de respuesta aceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"La respuesta no está vacía\", function () {",
                  "pm.expect(pm.response.text().length).to.be.above(0);",
                  "});",
                  ""
